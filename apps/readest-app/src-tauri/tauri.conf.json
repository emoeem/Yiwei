{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Yiwei",
  "mainBinaryName": "yiwei",
  "identifier": "com.yiwei.reader",
  "version": "../package.json",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build && pnpm upload-sourcemaps"
  },
  "app": {
    "windows": [],
    "security": {
      "capabilities": ["default", "desktop-capability"],
      "csp": {
        "default-src": "'self' 'unsafe-inline' blob: data: customprotocol: asset: http://asset.localhost http://rangefile.localhost ipc: http://ipc.localhost",
        "connect-src": "'self' blob: data: asset: http://asset.localhost http://rangefile.localhost ipc: http://ipc.localhost http://*:* https://*:* https://*.sentry.io https://*.posthog.com https://*.deepl.com https://*.wikipedia.org https://*.wiktionary.org https://*.supabase.co wss://speech.platform.bing.com https://*.cloudflarestorage.com https://translate.googleapis.com https://translate.toil.cc https://*.microsofttranslator.com https://edge.microsoft.com https://*.googleusercontent.com https://graph.microsoft.com https://login.microsoftonline.com",
        "img-src": "'self' blob: data: asset: http://asset.localhost https://* https://*:* http://* http://*:*",
        "media-src": "'self' blob: data: asset: http://asset.localhost https://* https://*:* http://* http://*:*",
        "style-src": "'self' 'unsafe-inline' blob: asset: http://asset.localhost https://cdn.jsdelivr.net https://fonts.googleapis.com https://cdnjs.cloudflare.com",
        "font-src": "'self' blob: data: asset: http://asset.localhost tauri: https://db.onlinewebfonts.com https://cdn.jsdelivr.net https://fonts.gstatic.com https://cdnjs.cloudflare.com",
        "frame-src": "'self' blob: asset: http://asset.localhost https://*.stripe.com",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' data: blob: asset: http://asset.localhost https://*.sentry.io https://*.posthog.com  https://*.stripe.com"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$RESOURCE/**",
            "$APPDATA/**/*",
            "$APPCACHE/**/*",
            "$TEMP/**/*",
            "**/Yiwei/**/*",
            "/private/var/mobile/Containers/Data/Application/**/*"
          ],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installerHooks": "nsis/installer-hooks.nsh",
        "installMode": "both"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "section": "text",
        "depends": ["libwebkit2gtk-4.1-0"]
      },
      "rpm": {
        "depends": ["libwebkit2gtk-4.1.so.0()(64bit)"]
      },
      "appimage": {
        "files": {
          "bin/00-no-userns-prompt.hook": "appimage/00-no-userns-prompt.hook"
        }
      }
    },
    "android": {
      "minSdkVersion": 26
    },
    "iOS": {
      "infoPlist": "./Info-ios.plist",
      "minimumSystemVersion": "16.4"
    },
    "fileAssociations": [
      {
        "name": "EPUB Document",
        "ext": ["epub"],
        "contentTypes": ["org.idpf.epub-container"],
        "description": "EPUB file",
        "mimeType": "application/epub+zip",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "MOBI Document",
        "ext": ["mobi"],
        "contentTypes": ["org.mobipocket.mobi"],
        "description": "MOBI file",
        "mimeType": "application/x-mobipocket-ebook",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "AZW Document",
        "ext": ["azw"],
        "contentTypes": ["com.amazon.azw", "com.amazon.azw3"],
        "description": "AZW file",
        "mimeType": "application/vnd.amazon.ebook",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "AZW Document",
        "ext": ["azw3"],
        "contentTypes": ["com.amazon.azw", "com.amazon.azw3"],
        "description": "AZW3 file",
        "mimeType": "application/vnd.amazon.mobi8-ebook",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "FB2 Document",
        "ext": ["fb2"],
        "contentTypes": ["com.yiwei.fb2"],
        "description": "FB2 file",
        "mimeType": "application/x-fictionbook+xml",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "CBZ Archive",
        "ext": ["cbz"],
        "contentTypes": ["com.yiwei.cbz"],
        "description": "CBZ file",
        "mimeType": "application/vnd.comicbook+zip",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "PDF Document",
        "ext": ["pdf"],
        "contentTypes": ["com.adobe.pdf"],
        "description": "PDF file",
        "mimeType": "application/pdf",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "Text File",
        "ext": ["txt"],
        "contentTypes": ["public.plain-text"],
        "description": "TXT file",
        "mimeType": "text/plain",
        "role": "Viewer",
        "rank": "Alternate"
      },
      {
        "name": "Markdown Document",
        "ext": ["md"],
        "contentTypes": ["net.daringfireball.markdown"],
        "description": "Markdown file",
        "mimeType": "text/markdown",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "cli": {
      "description": "Yiwei CLI",
      "args": [
        {
          "name": "file1",
          "index": 1,
          "takesValue": true
        },
        {
          "name": "file2",
          "index": 2,
          "takesValue": true
        },
        {
          "name": "file3",
          "index": 3,
          "takesValue": true
        },
        {
          "name": "file4",
          "index": 4,
          "takesValue": true
        }
      ]
    },
    "deep-link": {
      "mobile": [
        {
          "scheme": ["https"],
          "host": "yiwei.invalid",
          "appLink": true
        },
        {
          "scheme": ["yiwei"],
          "appLink": false
        },
        {
          "scheme": ["yiwei-onedrive"],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": ["yiwei", "yiwei-onedrive"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE3OUE3N0U4QzdEMTU5OApSV1NZRlgyTWZxZDVBU3VTRGcxa0FiSU5ROFFMZVVLUFFSOWdJUUxNTHFzVEV3U2ZETDFKdi9ZSQo=",
      "endpoints": ["https://updates.invalid/latest.json"]
    },
    "webview-upgrade": {
      "minUpgradeMajor": 121,
      "minSupportedMajor": 111
    }
  }
}
